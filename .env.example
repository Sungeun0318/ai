# 복사해서 .env 로 만든 뒤 실제 값으로 채우기
# (.env 는 .gitignore 에 포함됨)

# ─── 서버 ────────────────────────────────────────────
APP_NAME=beggar-ai
APP_ENV=local
HOST=0.0.0.0
PORT=8000

# ─── 백엔드 연동 (필요 시) ───────────────────────────
# Spring 백엔드가 호출하므로 Python 이 백엔드를 호출할 일은 드물지만
# 콜백/검증용으로 필요할 수 있음
BACKEND_BASE_URL=http://localhost:8080
BACKEND_API_KEY=

# ─── 외부 API ────────────────────────────────────────
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── AWS S3 (영수증 이미지 다운로드용) ───────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=

# ─── OCR (선택) ──────────────────────────────────────
# CLOVA_OCR_URL=
# CLOVA_OCR_SECRET=

# ─── LLM (선택) ──────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ─── 로깅 ────────────────────────────────────────────
LOG_LEVEL=DEBUG
